#!/usr/bin/env sh

npm run test:architecture
npm run test:docs
npm run test:unit

CHANGED_FILES="$(git diff --name-only @{upstream}...HEAD 2>/dev/null || git diff --name-only HEAD~1...HEAD 2>/dev/null || true)"
PATTERN='^(app/|components/|context/|hooks/|lib/|tests/e2e/|playwright\.config\.ts)'

if command -v rg >/dev/null 2>&1; then
  if echo "$CHANGED_FILES" | rg -q "$PATTERN"; then
    echo "Running Playwright smoke tests for UI-related changes..."
    npm run test:e2e:smoke
  else
    echo "Skipping Playwright smoke tests: no UI/e2e relevant changes detected."
  fi
else
  if echo "$CHANGED_FILES" | grep -Eq "$PATTERN"; then
    echo "Running Playwright smoke tests for UI-related changes..."
    npm run test:e2e:smoke
  else
    echo "Skipping Playwright smoke tests: no UI/e2e relevant changes detected."
  fi
fi
